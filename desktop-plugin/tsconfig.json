{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmitOnError": true,
    "outDir": "build",
    "removeComments": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "typeRoots": [],
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts"
  ]
}
